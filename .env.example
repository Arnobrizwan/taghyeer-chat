# Both are optional — the app falls back to these exact values if unset.
# Override only if the API moves.

# REST base. Note the /api suffix; the socket origin below deliberately omits it.
NEXT_PUBLIC_API_BASE_URL=https://frontend-task-chatapp.onrender.com/api

# Socket.io origin — the ROOT host, not /api. Socket.io serves itself at /socket.io/.
NEXT_PUBLIC_SOCKET_ORIGIN=https://frontend-task-chatapp.onrender.com
